# 伺服器埠號（預設 3000）
PORT=3000

# Session 加密金鑰，正式環境請務必更換
SESSION_SECRET=please-change-this-to-a-long-random-string

# 此帳號（電子郵件或使用者名稱）在註冊／登入時會成為管理員（可選）
# ADMIN_EMAIL=you@example.com

# 與 ADMIN_EMAIL 一併使用：啟動時若尚無此帳號，會用此 bcrypt 雜湊預先建立管理員
# ADMIN_PASSWORD_HASH=$2a$10$...

# 公開網址的來源（robots.txt、sitemap、官網連結、Open Graph 使用）
# 優先讀取 PUBLIC_BASE_URL，其次 PUBLIC_ORIGIN。未設定時以請求 Host 並使用 https
# PUBLIC_BASE_URL=https://yifang-ad-builder.onrender.com
# PUBLIC_ORIGIN=https://yifang-ad-builder.onrender.com

# Google Search Console 網站驗證碼，會加在首頁與已發佈頁的 <meta name="google-site-verification">
# GOOGLE_SITE_VERIFICATION=paste-your-token-here

# 資料存放目錄（預設為專案內 data/；上傳圖片在 DATA_DIR/uploads/）
# DATA_DIR=./data
